# App
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://yourdomain.com
NEXT_PUBLIC_APP_NAME=SupportFlow
NEXT_PUBLIC_APP_DESCRIPTION=

# Auth (NextAuth v5 — AUTH_* is the current name; NEXTAUTH_* is read as a fallback)
AUTH_URL=https://yourdomain.com
AUTH_SECRET=generate-with-openssl-rand-base64-32

# MongoDB (use Atlas for cloud, or local URI for Docker self-host) — required
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/supportflow

# Google OAuth (from console.cloud.google.com) — optional, Google login is hidden if unset
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# JWT — required (used for API/mobile client tokens, e.g. widget/socket auth)
JWT_SECRET=generate-with-openssl-rand-base64-32
JWT_EXPIRES_IN=7d

# Encryption — required once any WhatsApp integration is connected (encrypts stored access tokens)
# generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Gemini AI (from aistudio.google.com) — optional, AI auto-reply is disabled if unset
GEMINI_API_KEY=

# Firebase (from firebase console → project settings) — optional
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ImageKit (from imagekit.io dashboard) — optional, used for avatar/attachment uploads
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Transactional email (SMTP) — optional; used for invites/password-reset/alerts only.
# Emails are silently skipped (logged) if SMTP_USER is unset.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SupportFlow <noreply@supportflow.app>

# Resend (resend.com) — bulk email campaigns. Separate from SMTP above: SMTP handles
# one-off transactional mail, Resend handles the campaign send volume + deliverability +
# open/click/bounce tracking. Campaigns are disabled with a clear error if unset.
RESEND_API_KEY=
RESEND_FROM_EMAIL=campaigns@yourdomain.com
# From Resend dashboard → Webhooks, after pointing it at /api/webhooks/email — required
# to verify inbound webhook events are really from Resend (Svix HMAC signature).
RESEND_WEBHOOK_SECRET=

# Pusher (pusher.com) — optional, used to push live typing/chat events to the public widget
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=ap2

# Redis — optional. Powers BullMQ (WhatsApp + email campaign queues) and distributed rate
# limiting; the app falls back to direct/in-process sending and in-memory rate limiting
# if unreachable.
REDIS_URL=redis://localhost:6379

# Stripe — reserved for future billing integration; not yet wired into any route.
# Today, POST /api/subscriptions is a SUPER_ADMIN-only manual grant with no payment step.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# One-time setup endpoint guard (POST /api/setup) — optional
SETUP_SECRET=
